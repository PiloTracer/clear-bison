# ClearBison — template for .env.dev / .env.prd
# Copy via: ./bin/start.sh <dev|prd> setup
# Only .env* files live at repo root. Do not add .env* under frontend/ or backend/.

COMPOSE_PROJECT_NAME=clearbison-ENV
APP_ENV=ENV
STACK_SUFFIX=-ENV
PUBLIC_HOST=logicbison.com
BIND_ADDRESS=0.0.0.0

# Random free ports — generated once by ./bin/start.sh setup
API_PORT=0
WEB_PORT=0

# Browser-facing API base (empty = same-origin / relative via PUBLIC_HOST:API_PORT in start output)
NEXT_PUBLIC_API_BASE=

CONTACT_INBOX=hello@clearbison.com
CORS_ORIGINS=*
